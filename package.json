{
  "name": "wslpilot",
  "version": "0.2.0",
  "private": true,
  "description": "WSLPilot — WSL 的驾驶舱。现代化 Windows Subsystem for Linux 图形化控制中枢。",
  "license": "MIT",
  "packageManager": "npm@12.0.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @wslpilot/desktop",
    "build": "npm run tokens && npm run build --workspaces --if-present && npm run package --workspace @wslpilot/desktop",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.tools.json --noEmit",
    "lint": "eslint . && stylelint \"**/*.{scss,css,vue}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:component": "vitest run -c vitest.component.config.ts --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --grep @visual",
    "smoke:product": "node scripts/smoke-product.mjs",
    "tokens": "tsx scripts/gen-tokens.ts",
    "tokens:check": "tsx scripts/gen-tokens.ts --check",
    "postinstall": "npm run tokens",
    "changeset": "changeset",
    "release": "changeset version && npm run build",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "engines": {
    "node": ">=22.22",
    "npm": ">=12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "happy-dom": "^21.0.4",
    "postcss-html": "^2.0.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.10",
    "stylelint": "^17.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "electron@45.2.1": true,
    "esbuild@0.28.2": true,
    "vue-demi@0.14.10": true,
    "@parcel/watcher@2.6.0": true,
    "node-pty@1.1.0": true
  }
}
